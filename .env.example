# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://zetaone.dpdns.org

# Analytics — leave blank to keep analytics disabled
NEXT_PUBLIC_ANALYTICS_ID=

# Which analytics provider to use when NEXT_PUBLIC_ANALYTICS_ID is set
# Options: none | google | plausible | cloudflare
NEXT_PUBLIC_ANALYTICS_PROVIDER=none

# Future API base URL (not yet used)
NEXT_PUBLIC_API_URL=

# Future contact form endpoint (not yet used)
CONTACT_FORM_ENDPOINT=

# Future CDN base URL for large assets (not yet used)
NEXT_PUBLIC_CDN_URL=
